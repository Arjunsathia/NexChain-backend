# ─── Server ──────────────────────────────────────────────
# Avoid 5000 on macOS (used by AirPlay Receiver)
PORT=4001
NODE_ENV=development
# Set to false to run the API without the order engine. Only ONE running
# instance may have the engine enabled.
ENGINE_ENABLED=true

# Frontend URL: used for CORS and links in emails
CLIENT_URL=http://localhost:5173
# Extra allowed CORS origins, comma-separated (e.g. your deployed frontend)
CORS_ORIGINS=https://nexchain-black.vercel.app

# ─── Database (required) ─────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/nexchain
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexchain
MONGO_URI=mongodb://127.0.0.1:27017/nexchain

# ─── Auth secrets (required) ─────────────────────────────
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
OTP_SECRET=
# Encrypts stored 2FA secrets. Changing it disables everyone's 2FA enrollment
TOTP_ENC_KEY=

# ─── Google OAuth ────────────────────────────────────────
# Must match VITE_GOOGLE_CLIENT_ID in the frontend
GOOGLE_CLIENT_ID=

# ─── Email (Nodemailer) ──────────────────────────────────
# For Gmail use an App Password, not your normal password
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Inbox that receives "Contact support" messages (defaults to EMAIL_USER)
SUPPORT_EMAIL=

# ─── AI chat (Gemini) ────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Cloudinary (optional; falls back to local uploads/) ─
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Market data ─────────────────────────────────────────
# CryptoCompare key for the news feed (recommended in production)
CRYPTO_COMPARE_API_KEY=
# Binance WebSocket base; switch to wss://stream.binance.us:9443 if binance.com is blocked
BINANCE_WS_URL=wss://stream.binance.com:9443
