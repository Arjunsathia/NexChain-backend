# NexChain Backend - Environment Variables Template

# --- SERVER CONFIG ---
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- DATABASE (MongoDB) ---
# Replace with your local or Atlas connection string
MONGO_URI=mongodb://localhost:27017/nexchain

# --- AUTHENTICATION ---
# A strong secret key for JWT signature
JWT_SECRET=your_super_secret_jwt_key_here

# --- EMAIL SERVICE (SMTP) ---
# Used for OTPs and support notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# --- GOOGLE OAUTH (If applicable) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
